# Public site URL — used for canonical URLs, sitemap and Open Graph.
# REQUIRED before launch: the real production domain is not yet confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Storefront API. Leave empty to run on clearly-marked MOCK DATA.
# The Storefront access token is a public, browser-safe token by design.
# Get it from the Headless sales channel in Shopify Admin.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=h2w8qc-az.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-07

# Contact form backend (any endpoint accepting a POSTed FormData body, e.g. Formspree).
# Leave empty and the form says it is not connected yet; it never fakes a send.
NEXT_PUBLIC_CONTACT_ENDPOINT=
